# University Cyber Range — copy to .env
APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
DATABASE_URL=sqlite:///./data/cyberrange.db
# Production:
# DATABASE_URL=postgresql+psycopg2://cyberrange:change-me@postgres:5432/cyberrange
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Allow other PCs on the same LAN (10/8, 172.16/12, 192.168/16, *.local) to open the login page.
CORS_ALLOW_LAN=true
COMPUTE_PROVIDER=auto
HOST_TOTAL_RAM_MB=131072
HOST_RESERVE_RAM_MB=20480
HOST_TOTAL_STORAGE_GB=3276
THRESHOLD_WARNING=85
THRESHOLD_HIGH=90
THRESHOLD_BLOCK=90
COOKIE_SECURE=false

# AUKC "AU Kamra AI Agent" — offline PDF book-library search (POST /api/aukc/search).
# Fully self-contained: admins upload PDF books, text is indexed locally and searched
# with a BM25 relevance algorithm. No external AI, no API keys.
# Max size (MB) of an admin-uploaded PDF book.
AUKC_BOOK_MAX_MB=50
