{
  "name": "University Cyber Range",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash scripts/cyberrange-boot.sh",
  "terminals": [
    {
      "name": "cyber-api",
      "command": "bash scripts/cyberrange-boot.sh; tail -F backend/data/api.log",
      "description": "Keeps the API and nginx portal up (ports 80/8080/8000) and follows the API log."
    }
  ],
  "ports": [
    { "name": "portal", "port": 80 },
    { "name": "portal-alt", "port": 8080 },
    { "name": "api", "port": 8000 }
  ]
}
