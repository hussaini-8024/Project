{
  "name": "University Cyber Range",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash scripts/cyberrange-boot.sh",
  "terminals": [
    {
      "name": "cyber-api",
      "command": "bash scripts/cyberrange-boot.sh; tail -F backend/data/api.log",
      "description": "Portal on :80 (http://127.0.0.1/login and http://172.26.1.3/login). API on :18000."
    }
  ],
  "ports": [
    { "name": "portal", "port": 80 },
    { "name": "portal-alt", "port": 8080 },
    { "name": "portal-extra", "port": 18080 },
    { "name": "api", "port": 18000 }
  ]
}
