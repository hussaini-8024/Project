{
  "name": "University Cyber Range",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash scripts/cyberrange-boot.sh",
  "terminals": [
    {
      "name": "cyber-api",
      "command": "bash scripts/cyberrange-boot.sh; tail -F backend/data/api.log",
      "description": "Keeps the API (:18000) and nginx portal (:18080/:18081) up and follows the API log."
    }
  ],
  "ports": [
    { "name": "portal", "port": 18080 },
    { "name": "portal-alt", "port": 18081 },
    { "name": "api", "port": 18000 }
  ]
}
