[Unit]
Description=University Cyber Range API (FastAPI / uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__ROOT__/backend
Environment=PYTHONUNBUFFERED=1
Environment=CORS_ALLOW_LAN=true
Environment=COOKIE_SECURE=false
Environment=PUBLIC_UI_PORT=80
EnvironmentFile=-__ROOT__/backend/.env
ExecStartPre=/usr/local/sbin/cyberrange-boot --prepare-only
ExecStart=__ROOT__/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=2
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
